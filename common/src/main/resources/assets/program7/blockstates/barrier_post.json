{
  "multipart": [
    { "apply": { "model": "program7:block/barrier_post_post" } },
    { "when": { "north": "true" }, "apply": { "model": "program7:block/barrier_post_side", "uvlock": true } },
    { "when": { "east": "true" }, "apply": { "model": "program7:block/barrier_post_side", "y": 90, "uvlock": true } },
    { "when": { "south": "true" }, "apply": { "model": "program7:block/barrier_post_side", "y": 180, "uvlock": true } },
    { "when": { "west": "true" }, "apply": { "model": "program7:block/barrier_post_side", "y": 270, "uvlock": true } }
  ]
}
